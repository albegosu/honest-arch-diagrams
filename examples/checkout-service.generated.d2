# Honest request-path diagram for `checkout`.
# Generated by scripts/to-d2.mjs — accent marks ONLY the verified path.

direction: right

vars: {
  accent: "#2563eb"
}

Edge: Edge {
  dns: "checkout.example.com"
  lb: "Load balancer"
  tls: "TLS termination"
}

Gateway: Gateway {
  ingress: "Ingress"
}

Identity: Identity {
  oauth: "oauth2-proxy"
}

App: App {
  svc: "checkout"
}

Workload: Workload {
  pod: "checkout-7c9…"
}

Data: Data {
  pg: "Postgres"
  pg.style.stroke-dash: 3
  redis: "Redis"
  redis.style.stroke-dash: 3
}

Edge.dns -> Edge.lb -> Gateway.ingress -> Identity.oauth -> App.svc -> Workload.pod: {
  style: { stroke: ${accent}; stroke-width: 2 }
}

App.svc -> Data.pg: "uses (secret DATABASE_URL)" {
  style: { stroke-dash: 3 }
}
App.svc -> Data.redis: "uses (env REDIS_HOST)" {
  style: { stroke-dash: 3 }
}

Release: "Also in this release" {
  style: { stroke-dash: 4 }
  prometheus: "Prometheus"
}
