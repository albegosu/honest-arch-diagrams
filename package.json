{
  "name": "honest-arch-diagrams",
  "version": "0.6.1",
  "description": "Agent skill: honest service-topology / request-path diagrams. Verified path vs inferred companions, never hallucinate components.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "honest-arch-lint": "scripts/lint.mjs"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "schema": "node scripts/schema.mjs",
    "test": "node scripts/test.mjs",
    "layout": "node scripts/layout.mjs examples/checkout-service.model.json --svg examples/checkout-service.layout.svg",
    "from-k8s": "node adapters/k8s/from-k8s.mjs adapters/k8s/fixtures/checkout.k8s.json",
    "from-terraform": "node adapters/terraform/from-terraform.mjs adapters/terraform/fixtures/orders-edge.tfshow.json",
    "from-openapi": "node adapters/openapi/from-openapi.mjs adapters/openapi/fixtures/orders.openapi.json",
    "render": "d2 examples/checkout-service.d2 examples/checkout-service.svg"
  },
  "keywords": [
    "agent-skills",
    "ai-skills",
    "architecture-diagrams",
    "request-path",
    "kubernetes",
    "terraform",
    "openapi",
    "d2",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albegosu/honest-arch-diagrams.git"
  },
  "homepage": "https://github.com/albegosu/honest-arch-diagrams#readme",
  "bugs": {
    "url": "https://github.com/albegosu/honest-arch-diagrams/issues"
  }
}
